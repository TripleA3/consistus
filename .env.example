# Fannero — environment variables

# Postgres connection string (e.g. from Vercel Postgres / Neon, or Supabase).
# Required for local dev: copy this file to .env and fill it in.
# On Vercel, this is injected automatically once you attach a Postgres
# database to the project under Storage.
DATABASE_URL=

# Base URL of the real API, once one exists outside this app.
NEXT_PUBLIC_API_BASE_URL=

# Payment provider (Paystack/Flutterwave), swapped in behind
# src/lib/payments/PaymentProvider.ts.
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=

# Media storage (video upload/playback), swapped in behind a media
# provider interface once the delivery/upload screens are built.
MEDIA_STORAGE_BUCKET_URL=
