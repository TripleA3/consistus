# Fannero — environment variables
# No real backend exists yet; the app runs entirely against mock data
# (src/lib/mock) behind the data-access layer (src/lib/api). These are
# placeholders for when real integrations are wired in.

# Base URL of the real API, once it exists.
NEXT_PUBLIC_API_BASE_URL=

# Payment provider (Paystack/Flutterwave), swapped in behind
# src/lib/payments/PaymentProvider.ts.
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=

# Media storage (video upload/playback), swapped in behind a media
# provider interface once the delivery/upload screens are built.
MEDIA_STORAGE_BUCKET_URL=
